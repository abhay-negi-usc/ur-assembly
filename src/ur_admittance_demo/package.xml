<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur_admittance_demo</name>
  <version>0.1.0</version>
  <description>
    Admittance-control demo for a UR10e using the ros2_control admittance_controller.
    Streams the initial pose as a hold reference so the TCP yields to external force and
    springs back per the configured Cartesian mass/damping/stiffness.
  </description>
  <maintainer email="negiabhay98@gmail.com">abhay</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <!-- Runtime controller + kinematics plugin (not part of the UR driver set) -->
  <exec_depend>admittance_controller</exec_depend>
  <exec_depend>kinematics_interface_kdl</exec_depend>
  <exec_depend>controller_manager</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
