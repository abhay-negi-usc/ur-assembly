<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur_gripper_bringup</name>
  <version>0.1.0</version>
  <description>
    Integrated bringup for a UR10e with a Robotiq 2F-85 gripper under a SINGLE
    controller_manager. Provides a combined URDF (arm + coupler + gripper, both ros2_control)
    fed to the UR driver via description_launchfile, plus the gripper controllers and a
    serial-port preflight check.
  </description>
  <maintainer email="negiabhay98@gmail.com">abhay</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ur_robot_driver</exec_depend>
  <exec_depend>ur_description</exec_depend>
  <exec_depend>ur_client_library</exec_depend>
  <exec_depend>robotiq_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
