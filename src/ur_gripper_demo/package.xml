<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur_gripper_demo</name>
  <version>0.1.0</version>
  <description>
    Demo of a Robotiq 2F-85 gripper on a UR control box via the ros2_control
    robotiq_gripper_controller (control_msgs/action/GripperCommand). Cycles the gripper
    through open / partial / closed positions. Gripper only -- no arm movement.
  </description>
  <maintainer email="negiabhay98@gmail.com">abhay</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
